<Project>
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    
    <!-- ASP.NET Core Repository Standards -->
    <RepoRoot>$([System.IO.Path]::GetDirectoryName($([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)'))))</RepoRoot>
    <ArtifactsPath>$(RepoRoot)/artifacts</ArtifactsPath>
    
    <!-- Package defaults -->
    <PackageIdPrefix>Microsoft.AspNetCore</PackageIdPrefix>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/DimQ1/AspNetQwen</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DimQ1/AspNetQwen.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Authors>DimQ1</Authors>
    <Company>DimQ1</Company>
    <Copyright>Copyright © DimQ1. All rights reserved.</Copyright>
    
    <!-- Build settings -->
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    
    <!-- Versioning -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix></VersionSuffix>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>
</Project>
